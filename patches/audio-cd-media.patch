 namespace PS1 {
+struct NativeCDState {
+#ifdef _WIN32
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    ~NativeCDState() { if (handle != INVALID_HANDLE_VALUE) CloseHandle(handle); }
+#endif
+};
+
+bool ISOReader::OpenNativeCD(const std::string& uri) {
+#ifdef _WIN32
+    if (uri.size() != 9 || uri.compare(0, 7, "cdda://") || uri[8] != ':' ||
+        uri[7] < 'A' || uri[7] > 'Z') return false;
+    wchar_t root[] = L"D:\\";
+    root[0] = static_cast<wchar_t>(uri[7]);
+    if (GetDriveTypeW(root) != DRIVE_CDROM) return false;
+    wchar_t device[] = L"\\\\.\\D:";
+    device[4] = root[0];
+    auto cd = std::make_unique<NativeCDState>();
+    cd->handle = CreateFileW(device, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                             nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (cd->handle == INVALID_HANDLE_VALUE) return false;
+    CDROM_TOC toc{};
+    DWORD returned = 0;
+    if (!DeviceIoControl(cd->handle, IOCTL_CDROM_READ_TOC, nullptr, 0,
+                         &toc, sizeof toc, &returned, nullptr) ||
+        toc.FirstTrack != 1 || toc.LastTrack < 1 || toc.LastTrack > 99) return false;
+    const int count = toc.LastTrack;
+    if (returned < offsetof(CDROM_TOC, TrackData) + (count + 1) * sizeof(TRACK_DATA)) return false;
+    auto lba = [](const UCHAR* msf) -> uint32_t {
+        const uint32_t frames = (static_cast<uint32_t>(msf[1]) * 60 + msf[2]) * 75 + msf[3];
+        return frames >= 150 ? frames - 150 : 0;
+    };
+    const uint32_t sectors = lba(toc.TrackData[count].Address);
+    if (!sectors || toc.TrackData[count].TrackNumber != 0xAA) return false;
+    std::vector<CDTrack> tracks;
+    bool audio = false;
+    uint32_t previous = 0;
+    for (int i = 0; i < count; ++i) {
+        const auto& entry = toc.TrackData[i];
+        const uint32_t start = lba(entry.Address);
+        if (entry.TrackNumber != i + 1 || start < previous || start >= sectors) return false;
+        const bool is_audio = (entry.Control & 4) == 0;
+        audio |= is_audio;
+        tracks.push_back({i + 1, is_audio, start, start});
+        previous = start;
+    }
+    if (!audio) return false;
+    tracks_ = std::move(tracks);
+    disc_sector_count_ = sectors;
+    bin_path_ = uri;
+    native_cd_ = std::move(cd);
+    is_open_ = true;
+    return true;
+#else
+    (void)uri;
+    return false;
+#endif
+}
 
