diff --git a/runtime/include/cdrom_media_id.h b/runtime/include/cdrom_media_id.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/cdrom_media_id.h
@@ -0,0 +1,15 @@
+#ifndef PSX_CDROM_MEDIA_ID_H
+#define PSX_CDROM_MEDIA_ID_H
+#include <stdint.h>
+/* GetID second response. Audio media is unlicensed: INT5, flag 0x90,
+ * no SCEx region. Data-disc behavior remains the existing licensed response.
+ * Reference: psx-spx, CDROM Drive / GetID command 1Ah. */
+static inline void cdrom_media_id(uint8_t status, int audio_only,
+                                 const uint8_t region[4], uint8_t out[8]) {
+    out[0] = (uint8_t)(status | (audio_only ? 0x08 : 0));
+    out[1] = audio_only ? 0x90 : 0;
+    out[2] = audio_only ? 0 : 0x20;
+    out[3] = 0;
+    for (int i = 0; i < 4; ++i) out[4 + i] = audio_only ? 0 : (uint8_t)region[i];
+}
+#endif
