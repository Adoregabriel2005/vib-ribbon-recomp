+namespace {
+int language_id(const char* value) {
+    if (!value) return -1;
+    if (!std::strcmp(value, "en") || !std::strcmp(value, "en-US")) return 0;
+    if (!std::strcmp(value, "pt-BR") || !std::strcmp(value, "pt-br")) return 1;
+    if (!std::strcmp(value, "it") || !std::strcmp(value, "it-IT")) return 2;
+    return -1;
+}
+std::filesystem::path preference_path() {
+    if (const char* override_path = std::getenv("RECOMP_UI_LANGUAGE_FILE"))
+        return std::filesystem::u8path(override_path);
+#ifdef _WIN32
+    wchar_t exe[32768];
+    const DWORD size = GetModuleFileNameW(nullptr, exe, 32768);
+    if (size && size < 32768)
+        return std::filesystem::path(std::wstring(exe, size)).parent_path() / "interface-language.txt";
+#else
+    std::error_code error;
+    auto exe = std::filesystem::read_symlink("/proc/self/exe", error);
+    if (!error) return exe.parent_path() / "interface-language.txt";
+#endif
+    return std::filesystem::current_path() / "interface-language.txt";
+}
+std::atomic<int>& selected_language() {
+    static std::atomic<int> value{[] {
+        int id = language_id(RECOMP_UI_LANGUAGE);
+        try {
+            std::ifstream file(preference_path());
+            char saved[16]{};
+            file.getline(saved, sizeof saved);
+            const int restored = language_id(saved);
+            if (file && restored >= 0) id = restored;
+        } catch (...) {}
+        return id >= 0 ? id : 0;
+    }()};
+    return value;
+}
+}
 const char* launcher_i18n_language(void) {
-    return RECOMP_UI_LANGUAGE;
+    static const char* names[] = {"en", "pt-BR", "it"};
+    return names[selected_language().load()];
+}
+bool launcher_i18n_set_language(const char* language) {
+    const int id = language_id(language);
+    if (id < 0) return false;
+    static std::mutex save_mutex;
+    std::lock_guard<std::mutex> lock(save_mutex);
+    selected_language() = id;
+    try {
+        std::ofstream file(preference_path(), std::ios::binary | std::ios::trunc);
+        file << launcher_i18n_language() << '\n';
+        file.close();
+        return static_cast<bool>(file);
+    } catch (...) { return false; }
 }
 
