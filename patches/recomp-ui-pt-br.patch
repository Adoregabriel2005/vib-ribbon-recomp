diff --git a/src/common/backends/imgui/launcher_imgui.cpp b/src/common/backends/imgui/launcher_imgui.cpp
index fc1925f..d2b36f4 100644
--- a/src/common/backends/imgui/launcher_imgui.cpp
+++ b/src/common/backends/imgui/launcher_imgui.cpp
@@ -1733,11 +1733,14 @@ void eyebrow_tracked(const char* s) {
     // letter-spaced text
     float x = p.x + px(10.0f);
     ImU32 c = imcol(th.accent2);
-    char buf[2] = {0,0};
-    for (const char* q = s; *q; ++q) {
-        buf[0] = *q;
-        dl->AddText(ImVec2(x, p.y), c, buf);
-        x += ImGui::CalcTextSize(buf).x + px(2.2f);
+    for (const char* q = s; *q;) {
+        // Keep a complete UTF-8 code point when spacing localized headings.
+        // Splitting bytes produced two replacement glyphs for accented letters.
+        const char* end = q + 1;
+        while ((static_cast<unsigned char>(*end) & 0xC0u) == 0x80u) ++end;
+        dl->AddText(ImVec2(x, p.y), c, q, end);
+        x += ImGui::CalcTextSize(q, end).x + px(2.2f);
+        q = end;
     }
     ImGui::Dummy(ImVec2(x - p.x, h));
     ImGui::Spacing();
