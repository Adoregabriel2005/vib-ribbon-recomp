+/* The guest IRQ handler already saved the outgoing TCB and restored the target.
+ * Do not save CPUState here: it now belongs to the target, not the host stack
+ * being suspended. This is the LLE counterpart of the scheduler IRQ escape. */
+int psx_irq_thread_switch_fiber(CPUState* cpu, uint32_t outgoing_tcb, uint32_t target_tcb)
+{
+    if (!psx_is_valid_tcb(cpu, outgoing_tcb) ||
+        !psx_is_valid_tcb(cpu, target_tcb) ||
+        psx_tcb_state(cpu, target_tcb) != 0x4000u)
+        return 0;
+    HostThreadFiber* current = psx_bind_current_host_thread(cpu, outgoing_tcb);
+    HostThreadFiber* target = psx_get_or_create_host_thread(cpu, target_tcb);
+    if (!target) return 0;
+    target->return_fiber = current->fiber;
+    target->return_tcb = outgoing_tcb;
+    debug_server_log_thread_event(30, cpu, outgoing_tcb, target_tcb, cpu->pc);
+    psx_fiber_switch(target->fiber);
+    psx_set_current_tcb(cpu, outgoing_tcb);
+    return 1;
+}
